# 数据库文件位置（默认 data/knowledge.db）
DATABASE_PATH=./data/knowledge.db

# 应用连接是否只读（写入只发生在 scripts/ 下）。设为 false 时页面进程也能写
DATABASE_READONLY=true

# 五份知识 JSON 所在目录
KNOWLEDGE_DATA_DIR=/Users/lvwei/Documents/wanxi/AI全栈工程师笔试测试数据/project2_knowledge

# GLM embedding-3 向量文件
VECTOR_FILE=/Users/lvwei/WorkBuddy/futrue/rag-demo/data/index.json

# 站点根地址，用于 canonical / OpenGraph / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 智谱 GLM（embedding-3 用于建索引与查询向量化）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_EMBED_MODEL=embedding-3
GLM_EMBED_DIM=2048
GLM_CHAT_MODEL=glm-4-flash

# Strapi webhook / 定时任务调用 POST /api/reindex 时的 Bearer 令牌
# 生产环境不配置则接口直接拒绝，避免任何人触发付费的 embedding 调用
REINDEX_TOKEN=
