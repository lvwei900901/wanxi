# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.workbuddy/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
.next-verify/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Strapi 种子包（由 npm run kb:export-strapi 从本地库再生）
/data/strapi-seed/

# sqlite 数据库（由 npm run db:reset 从源 JSON + 向量文件重建）
/data/*.db
/data/*.db-wal
/data/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
