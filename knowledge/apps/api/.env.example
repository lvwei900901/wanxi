# ---- API 进程 ----
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 数据库默认解析到仓库根 data/knowledge.db
# KNOWLEDGE_DB_PATH=/absolute/path/to/knowledge.db

# ---- 智谱 GLM ----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_EMBED_MODEL=embedding-3
GLM_EMBED_DIM=2048
GLM_CHAT_MODEL=glm-4-flash

# 索引重建令牌：curl -H "Authorization: Bearer $REINDEX_TOKEN"
REINDEX_TOKEN=

# ---- 重建后通知 web 失效 ISR ----
# 不配这两项时重建照常进行，但页面要等 revalidate(300s) 才换内容，
# lastRun.revalidate.status 会记成 skipped（见 GET /api/v1/index/hook/status）。
# WEB_REVALIDATE_URL=http://127.0.0.1:3300/api/revalidate
# WEB_REVALIDATE_TOKEN=            # 与 apps/web 的 WEB_REVALIDATE_TOKEN 一致
# WEB_REVALIDATE_TAGS=kb           # 逗号分隔；kb 是 web 侧的整站总标签
# WEB_REVALIDATE_TIMEOUT_MS=3000   # 通知失败不能拖慢重建，超时即放弃
