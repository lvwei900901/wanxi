# ---- 前端（apps/web）----
# 站点根地址：canonical / OpenGraph / sitemap / JSON-LD 都用它
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 服务端取数地址（浏览器不直连 API，避免密钥与 CORS 暴露）
API_BASE_URL=http://127.0.0.1:3001/api/v1

# ISR 按需失效令牌：api 重建成功后回调 POST /api/revalidate 时校验。
# 必须与 apps/api 的 WEB_REVALIDATE_TOKEN 完全一致（openssl rand -hex 16 生成）。
# 不配 = 端点返回 503，页面只能等 revalidate(300s) 自然过期。
# WEB_REVALIDATE_TOKEN=

# 缓存保底过期时间（秒）。主动失效失效时才靠它兜底，不要为了「立刻生效」把它调到 0：
# 0 等于关掉 ISR，每个请求都要回源打 API。
# API_REVALIDATE=300
